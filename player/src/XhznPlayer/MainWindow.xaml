<Window x:Class="XhznPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="XHZN播放器"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#000000"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">
    <Grid>
        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" DefaultBackgroundColor="#000000"/>

        <Grid x:Name="EmptyPage" Background="#101418" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="760">
                <TextBlock Text="暂无项目" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap" FontSize="22" Foreground="#9AA3B2" Margin="0,24,0,8" HorizontalAlignment="Center">
                    请把发布包（.xhznpack）拷到下面这个固定目录，然后重新打开播放器。不要拷贝草稿 .xhzn。
                </TextBlock>
                <TextBlock x:Name="ProjectDirText" FontSize="26" Foreground="#3D8BFF" TextWrapping="Wrap" Margin="0,8,0,28" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="显示器" FontSize="18" Foreground="#9AA3B2" Margin="0,0,0,8"/>
                <ComboBox x:Name="DisplayCombo" SelectionChanged="OnDisplayChanged"/>
                <TextBlock x:Name="VersionText" FontSize="16" Foreground="#6B7380" Margin="0,28,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="LoadingPage" Background="#101418" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="正在加载" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingHint" Text="正在准备素材…" FontSize="22" Foreground="#9AA3B2" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="MessagePage" Background="#101418" Visibility="Collapsed">
            <TextBlock x:Name="MessageText" FontSize="56" FontWeight="Bold" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Margin="80"/>
        </Grid>

        <Border x:Name="TrialBanner" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,24,24,0" Background="#CCB00000" Padding="28,8" IsHitTestVisible="False">
            <TextBlock Text="试用" FontSize="48" FontWeight="Bold" Foreground="White"/>
        </Border>

        <Border x:Name="VolumeHud" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,80" Background="#CC101418" Padding="24,16" CornerRadius="8" IsHitTestVisible="False">
            <StackPanel Width="360">
                <TextBlock Text="系统音量" FontSize="16" Foreground="#9AA3B2"/>
                <ProgressBar x:Name="VolumeBar" Height="14" Margin="0,8,0,0" Minimum="0" Maximum="1"/>
            </StackPanel>
        </Border>

        <Border x:Name="ExitHotspot" Width="120" Height="120" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" MouseLeftButtonDown="OnExitHotspot"/>
    </Grid>
</Window>
