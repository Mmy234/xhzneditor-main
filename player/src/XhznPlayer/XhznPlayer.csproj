<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>XhznPlayer</AssemblyName>
    <RootNamespace>XhznPlayer</RootNamespace>
    <Product>XHZN播放器</Product>
    <AssemblyTitle>XHZN播放器</AssemblyTitle>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xhzn.PackFormat\Xhzn.PackFormat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <Target Name="CopyRuntime" AfterTargets="Build">
    <ItemGroup>
      <_RuntimeFiles Include="..\..\..\runtime\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeFiles)"
          DestinationFiles="@(_RuntimeFiles->'$(OutDir)runtime\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyRuntimeOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <_RuntimePublishFiles Include="..\..\..\runtime\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimePublishFiles)"
          DestinationFiles="@(_RuntimePublishFiles->'$(PublishDir)runtime\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
