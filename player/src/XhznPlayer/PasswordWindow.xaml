<Window x:Class="XhznPlayer.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="退出"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Width="420" Height="240"
        Background="#1B2128"
        FontFamily="Microsoft YaHei UI">
    <Border BorderBrush="#3D8BFF" BorderThickness="2" Padding="28">
        <StackPanel>
            <TextBlock Text="请输入退出密码" FontSize="22" Foreground="#F2F4F8" Margin="0,0,0,16"/>
            <PasswordBox x:Name="Box" Height="40" FontSize="20" Padding="8,6"/>
            <TextBlock x:Name="Hint" Foreground="#FF8A8A" Height="24" Margin="0,8,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="100" Margin="0,0,12,0" Click="OnCancel" Background="#3A4450"/>
                <Button Content="确定" Width="100" Click="OnOk" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
